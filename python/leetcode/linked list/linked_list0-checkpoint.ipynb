   "source": [
    "class Node:\n",
    "    def __init__(self,data):\n",
    "        self.node=data\n",
    "        self.next=None\n",
    "\n",
    "a = Node(5)\n",
    "b = Node(8)\n",
    "c = Node(9)\n",
    "a.next = b\n",
    "b.next = c\n",
    "head = a\n",
    "print(a.next.node)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "1c1997fa-4a45-46a0-8e26-1327b3970284",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5\n",
      "8\n",
      "9\n"
     ]
    }
   ],
   "source": [
    "# traverse\n",
    "curr = head\n",
    "while curr!=None:\n",
    "    print(curr.node)\n",
    "    curr=curr.next"
   ]
  },
